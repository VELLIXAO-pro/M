return {
  RelativeLayout;
  layout_width="match_parent";
  layout_height="match_parent";
  background="#1a1a1a";
  {
    LinearLayout;
    orientation="vertical";
    layout_width="match_parent";
    layout_height="match_parent";
    {
      RelativeLayout;
      layout_width="match_parent";
      layout_height="50dp";
      background="#dc143c";
      {
        TextView;
        text="SAMURAI METASPLOIT CONSOLE";
        textColor="#ffffff";
        layout_centerInParent="true";
        textStyle="bold";
      };
      {
        TextView;
        id="close_btn";
        text="CLOSE";
        textColor="#ffffff";
        layout_alignParentRight="true";
        layout_centerVertical="true";
        padding="15dp";
        clickable=true;
      };
    };
    {
      ScrollView;
      id="console_scroll";
      layout_width="match_parent";
      layout_height="0";
      layout_weight="1";
      padding="10dp";
      {
        LinearLayout;
        id="console_list";
        orientation="vertical";
        layout_width="match_parent";
        layout_height="wrap_content";
        {
          TextView;
          text="[!] Metasploit Framework v6.4.0-SAMURAI";
          textColor="#00ff00";
          typeface="MONOSPACE";
          textSize="12sp";
        };
        {
          TextView;
          text="[!] Type any command to start exploit simulation.";
          textColor="#ffffff";
          typeface="MONOSPACE";
          textSize="12sp";
        };
      };
    };
    {
      LinearLayout;
      layout_width="match_parent";
      layout_height="wrap_content";
      background="#222222";
      padding="10dp";
      gravity="center_vertical";
      {
        TextView;
        text="msf6 > ";
        textColor="#dc143c";
        textStyle="bold";
        typeface="MONOSPACE";
      };
      {
        EditText;
        id="console_input";
        layout_width="match_parent";
        layout_height="wrap_content";
        background="#00000000";
        textColor="#ffffff";
        hint="exploit...";
        hintTextColor="#444444";
        imeOptions="actionSend";
        singleLine="true";
        typeface="MONOSPACE";
        textSize="14sp";
      };
    };
  };
}
