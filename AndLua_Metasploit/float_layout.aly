{
  LinearLayout;
  layout_width="wrap_content";
  layout_height="wrap_content";
  {
    CardView;
    layout_width="50dp";
    layout_height="50dp";
    radius="25dp";
    cardBackgroundColor="#dc143c"; -- Crimson Red
    elevation="5dp";
    {
      ImageView;
      id="icon_image";
      layout_width="match_parent";
      layout_height="match_parent";
      src="https://raw.githubusercontent.com/google/material-design-icons/master/png/hardware/security/materialicons/48dp/1x/ic_security_white_48dp.png";
      padding="10dp";
      scaleType="fitCenter";
    };
  };
}
