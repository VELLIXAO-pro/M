{
  LinearLayout;
  layout_width="fill";
  layout_height="fill";
  orientation="vertical";
  backgroundColor="#1a1a1a";
  {
    TextView;
    text="SAMURAI INJECTOR";
    textColor="#dc143c";
    textSize="28sp";
    layout_gravity="center";
    padding="20dp";
    style="?android:attr/textViewStyle";
  };
  {
    CardView;
    layout_width="fill";
    layout_margin="10dp";
    cardBackgroundColor="#2a2a2a";
    radius="8dp";
    elevation="4dp";
    {
      LinearLayout;
      layout_width="fill";
      orientation="vertical";
      padding="16dp";
      {
        TextView;
        text="Target Configuration";
        textColor="#ffd700";
        textSize="14sp";
      };
      {
        EditText;
        id="edit_pkg";
        hint="Package Name (e.g. xx.yy.zz)";
        text="com.asobimo.aurcusonline.wx";
        layout_width="fill";
        textColor="#ffffff";
        hintTextColor="#888888";
      };
      {
        Button;
        id="btn_start";
        text="START GAME";
        layout_width="fill";
        backgroundColor="#dc143c";
        textColor="#ffffff";
        layout_marginTop="8dp";
      };
    };
  };
  {
    CardView;
    layout_width="fill";
    layout_margin="10dp";
    cardBackgroundColor="#2a2a2a";
    radius="8dp";
    elevation="4dp";
    {
      LinearLayout;
      layout_width="fill";
      orientation="vertical";
      padding="16dp";
      {
        TextView;
        text="Memory Search (Java Heap)";
        textColor="#ffd700";
        textSize="14sp";
      };
      {
        LinearLayout;
        layout_width="fill";
        orientation="horizontal";
        {
          EditText;
          id="edit_search";
          hint="Search Value";
          layout_weight=1;
          textColor="#ffffff";
          inputType="number";
        };
        {
          Button;
          id="btn_search";
          text="SEARCH";
          backgroundColor="#ffd700";
          textColor="#000000";
        };
      };
    };
  };
  {
    ListView;
    id="list_results";
    layout_width="fill";
    layout_height="fill";
    layout_weight=1;
    dividerHeight="1dp";
    divider="#333333";
  };
  {
    LinearLayout;
    layout_width="fill";
    orientation="horizontal";
    padding="10dp";
    backgroundColor="#2a2a2a";
    {
      EditText;
      id="edit_write";
      hint="Write Value";
      layout_weight=1;
      textColor="#ffffff";
      inputType="number";
    };
    {
      Button;
      id="btn_write";
      text="WRITE ALL";
      backgroundColor="#dc143c";
      textColor="#ffffff";
    };
    {
      Button;
      id="btn_clear";
      text="CLEAR";
      backgroundColor="#444444";
      textColor="#ffffff";
      layout_marginLeft="4dp";
    };
  };
}
